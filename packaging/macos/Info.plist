<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaterMD.app 的 bundle 描述。packaging/macos/bundle.sh 组装 .app 时替换
  __VERSION__，并生成 CFBundleIconFile 指定的图标。本地开发与发布 workflow 共用。

  LSMinimumSystemVersion 14.0 —— 平台基线 macOS 14 Sonoma
  (AGENTS.md §5:显式不支持 macOS 13 及以下)。
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>LaterMD</string>
  <key>CFBundleDisplayName</key>
  <string>LaterMD</string>
  <key>CFBundleIdentifier</key>
  <string>cn.ailater.LaterMD</string>
  <key>CFBundleExecutable</key>
  <string>latermd</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon.icns</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <!--
    应用图标。指向 Contents/Resources/AppIcon.icns(由 iconutil 从
    assets/logo/deliverables/macOS/AppIcon.iconset 合成,见 bundle.sh 与
    macos-dmg.yml)。**缺这一行时.app 仍能跑,但 Dock / Finder / 访达
    全部显示通用毛坯图标** —— 这是「图标改了没生效」最常见的原因:
    图标文件在包里,只是没人被告知去读它。
    CFBundleIconFile 按惯例写无扩展名的基名(有些老工具要求带 .icns,
    但 Cocoa 两种都认,无扩展名是Apple 官方示例的写法)。
  -->
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!--
    文件关联(2026-10-16)。**缺这一整段时LaterMD 在 Finder 的
    「打开方式」列表里根本不出现** —— 前面的 IconFile 缺失只是图标
    变毛坯,这段缺失是应用不存在于文件关联链路,症状与「没装上」一样。
    单实例能力(cli.rs + instance.rs)保证双击开进已有窗口。

    CFBundleDocumentTypes + LSItemContentTypes 两组都要写:
    - 后者是 UTI(14.0 起的现代口径),声明认得什么类型;
    - 前者声明「这类文件打开时该找谁」,缺了它 LaunchServices 根本
      不来找本应用。两组**互补**,只写一组都不生效。

    LSHandlerRank = Alternate 而非 Owner:只声明「我能编辑这类文件」,
    不抢现有用户的默认选择(与 AGENTS.md §5 的无签名/不抢默认值路线
    一致,也避免把用户已有的 MarkText 之类默认打开程序顶掉)。用户要设
    默认时,Finder「显示简介 → 打开方式 → 全部更改」里自选。

    扩展名与 latermd_search::MARKDOWN_EXTENSIONS 同源(仅 md/markdown),
    与 Linux .desktop / Windows 注册表三处一致。
  -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown 文档</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>md</string>
        <string>markdown</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
        <string>public.plain-text</string>
      </array>
    </dict>
  </array>
  <key>LSItemContentTypes</key>
  <array>
    <!-- 系统自带 Markdown UTI,不加则系统无法按类型匹配到本应用 -->
    <string>net.daringfireball.markdown</string>
    <string>public.plain-text</string>
  </array>
</dict>
</plist>
